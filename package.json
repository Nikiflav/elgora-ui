{
  "name": "elgora-ui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/elgora-ui.umd.cjs",
  "module": "./dist/elgora-ui.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs:build": "npm run docs:prepare && vite build --config docs/vite.config.ts",
    "predev": "npm run docs:prepare",
    "prebuild": "npm run docs:api",
    "docs:prepare": "npm run docs:api && npm run docs:content",
    "docs:api": "node tools/generate-api-docs.mjs",
    "docs:content": "node tools/generate-docs.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.x",
    "vite": "^8.x",
    "vite-plugin-dts": "^5.x",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "remixicon": "^4.9.1"
  }
}
